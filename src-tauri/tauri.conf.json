{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Turber",
  "version": "26.0.1",
  "identifier": "com.hp.turber",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Turber",
        "width": 1200,
        "height": 780,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "certificateThumbprint": "D87CB5D4B7E01C9B4B6FFD3168C25FEDC5EE0F80",
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "both",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "minimumWebview2Version": "110"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}